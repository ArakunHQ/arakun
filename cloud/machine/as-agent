#!/bin/sh
# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0 (see LICENSE in this folder)
# Runs an agent's ACP adapter, or its CLI, as `agent`, called as root by
# machine/run through sudo. The capabilities go before the user changes, bounding set
# included, so nothing the agent starts can get them back; no_new_privs keeps
# setuid programs (sudo among them) from raising it again. Group `work` and
# umask 002 let the server and the agent share the files under /work.
#
# The owner's model credentials (model-env) are root's file: they go into the
# agent's environment here and nowhere else, so the server never holds them.
set -eu
umask 0002
export HOME=/home/agent USER=agent LOGNAME=agent
model=/run/arakun/model.env
if [ -r "$model" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      [A-Z]*=*) export "$line" ;;
    esac
  done <"$model"
fi
# The first argument names the program, one of these and nothing else.
case ${1:-} in
  claude-acp) program=/opt/arakun/agent/node_modules/.bin/claude-agent-acp ;;
  claude) program=/opt/arakun/agent/claude ;;
  codex-acp) program=/opt/arakun/codex/node_modules/.bin/codex-acp ;;
  codex) program=/opt/arakun/codex/node_modules/.bin/codex ;;
  *)
    echo "as-agent: not a program of the agents: ${1:-}" >&2
    exit 64
    ;;
esac
# The server tells the Codex adapter to use an API key only when its own
# environment has one (core/src/agent/launch.rs), and here only the agent has
# it. The adapter uses the key when Codex has no sign-in, so a ChatGPT sign-in
# still comes first.
if [ "$1" = codex-acp ] && [ -n "${OPENAI_API_KEY:-}" ] && [ -z "${DEFAULT_AUTH_REQUEST:-}" ]; then
  export DEFAULT_AUTH_REQUEST='{"methodId":"api-key"}'
fi
shift
exec /usr/bin/setpriv --reuid=agent --regid=agent --init-groups \
  --inh-caps=-all --ambient-caps=-all --bounding-set=-all --no-new-privs \
  -- "$program" "$@"
